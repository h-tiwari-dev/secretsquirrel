{
  "name": "secretsquirrel",
  "version": "0.1.0",
  "description": "Secret prompts for Claude Code and Cursor agents. The agent names env vars, the human approves, the secret never enters LLM context.",
  "type": "module",
  "bin": {
    "secretsquirrel": "dist/cli.js",
    "agent-vault": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "mcp",
    "claude-code",
    "cursor",
    "secrets",
    "keychain",
    "1password",
    "bitwarden"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h-tiwari-dev/secretsquirrel.git"
  }
}
